generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  student
  faculty
  office_staff
}

model User {
  emailId     String   @id @map("email_id")
  role        Role
  name        String
  phoneNumber String?  @map("phone_number")
  usn         String?
  dept        String?
  designation String?
  otp         String
  teamId      String   @map("team_id")
  team        Team     @relation(fields: [teamId], references: [id])
  foundPosts  FoundPost[]
  claims      Claim[]
  resolutions Resolution[]
  lostRequests LostRequest[]
  notices      Notice[]
  doubtsAsked  Doubt[] @relation("DoubtAsker")
  doubtResponses DoubtResponse[] @relation("DoubtResponder")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([role, createdAt, emailId])
}

enum PostStatus {
  active
  archived
}

model FoundPost {
  id            String           @id
  title         String
  description   String?
  locationFound String?          @map("location_found")
  foundOn       DateTime?         @map("found_on") @db.Date
  status        PostStatus       @default(active)
  resolved      Boolean          @default(false)
  postedBy      String           @map("posted_by")
  poster        User             @relation(fields: [postedBy], references: [emailId], onDelete: Restrict)
  images        FoundPostImage[]
  claims        Claim[]
  resolution    Resolution?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt, id])
}

enum Decision {
  pending
  approved
  rejected
}

model Claim {
  id         String     @id
  postId     String     @map("post_id")
  post       FoundPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimantId String     @map("claimant_id")
  claimant   User       @relation(fields: [claimantId], references: [emailId], onDelete: Cascade)
  message    String
  decision   Decision   @default(pending)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  resolution Resolution?

  @@unique([postId, claimantId])
  @@index([postId, createdAt, id])
  @@index([claimantId, createdAt, id])
}

model Resolution {
  postId     String    @id @map("post_id")
  post       FoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimId    String    @unique @map("claim_id")
  claim      Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  note       String?
  resolvedBy String    @map("resolved_by")
  resolver   User      @relation(fields: [resolvedBy], references: [emailId], onDelete: Restrict)
  resolvedAt DateTime  @default(now()) @map("resolved_at")
}

model FoundPostImage {
  id          String    @id @default(cuid())
  postId      String    @map("post_id")
  post        FoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  storageKey  String    @map("storage_key")
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  position    Int

  @@index([postId, position])
}

model LostRequest {
  id          String     @id
  requesterId String     @map("requester_id")
  requester   User       @relation(fields: [requesterId], references: [emailId], onDelete: Cascade)
  title       String
  description String?
  locationLost String?   @map("location_lost")
  lostOn      DateTime?  @map("lost_on") @db.Date
  status      PostStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt, id])
  @@index([requesterId, status, createdAt, id])
}

enum NoticeStatus {
  active
  archived
}

model Notice {
  id             String       @id
  title          String
  body           String
  pinned         Boolean      @default(false)
  status         NoticeStatus @default(active)
  publishAt      DateTime?    @map("publish_at")
  sortAt         DateTime     @map("sort_at")
  attachmentKey  String?      @map("attachment_key")
  attachmentName String?      @map("attachment_name")
  attachmentType String?      @map("attachment_type")
  attachmentSize Int?         @map("attachment_size")
  publishedBy    String       @map("published_by")
  publisher      User         @relation(fields: [publishedBy], references: [emailId], onDelete: Restrict)
  doubts         Doubt[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, sortAt, id])
  @@index([publishedBy, status, sortAt, id])
}

model Doubt {
  id        String @id
  noticeId  String @map("notice_id")
  notice    Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  askerId   String @map("asker_id")
  asker     User @relation("DoubtAsker", fields: [askerId], references: [emailId], onDelete: Cascade)
  question  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  response  DoubtResponse?
  @@index([noticeId, createdAt, id])
  @@index([askerId, createdAt, id])
}

model DoubtResponse {
  doubtId     String @id @map("doubt_id")
  doubt       Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  message     String
  respondedBy String @map("responded_by")
  responder   User @relation("DoubtResponder", fields: [respondedBy], references: [emailId], onDelete: Restrict)
  respondedAt DateTime @default(now()) @map("responded_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model Team {
  id          String @id @default(cuid())
  institution String
  emailDomain String @map("email_domain")
  users       User[]
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
}
